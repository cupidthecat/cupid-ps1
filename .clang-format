# cupid-ps1 C style. Use clang-format 16 or newer.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++11

IndentWidth: 2
ContinuationIndentWidth: 4
TabWidth: 2
UseTab: Never
ColumnLimit: 120
LineEnding: LF

# Function, control-statement and type braces attach.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: false
  BeforeWhile: false
  IndentBraces: false
IndentCaseLabels: true
IndentPPDirectives: None

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: true

DerivePointerAlignment: false
PointerAlignment: Left
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements

# Keep the existing include groups, comments, and compact aligned tables.
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false
StatementMacros: [BSR_RW_PRIM, BSW_W_PRIM, BFR_R_PRIM, BFW_W_PRIM]
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
AlignEscapedNewlines: Left
AlignAfterOpenBracket: Align
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
MaxEmptyLinesToKeep: 1
